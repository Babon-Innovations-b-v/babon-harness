# Recording server config. The media pod's render-config init container fills
# each placeholder from the vault (infra/k8s/media/media-stack.yaml).

[http]
listen = 127.0.0.1:8000

[backend]
backends = nc1
videowidth = 1920
videoheight = 1080
# The claim media-recordings, so a file Talk has not fetched yet outlives a
# pod restart.
directory = /recordings

[nc1]
url = https://cloud.@DOMAIN@
secret = @TALK_RECORDING_SECRET@

[signaling]
signalings = sig1

[sig1]
url = https://signaling.@DOMAIN@
# Must equal the signaling server's [clients] internalsecret.
internalsecret = @TALK_INTERNAL_SECRET@
