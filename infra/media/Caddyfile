# Caddy on the media node: HTTPS (automatic Let's Encrypt) for its two public
# names. reverse_proxy upgrades WebSockets, which the signaling server needs.
# The upstreams (8080 signaling, 8000 recording) listen on the node's loopback only.

signaling.{$DOMAIN} {
	reverse_proxy 127.0.0.1:8080
}

recording.{$DOMAIN} {
	reverse_proxy 127.0.0.1:8000
}
