[Unit]
Description=Gateway deadman: does the assistant's Signal gateway still answer? Three failures page once.
After=network-online.target docker.service
Wants=network-online.target
OnFailure=harness-notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/harness/repo
EnvironmentFile=-/opt/harness/harness.env
ExecStart=/usr/bin/python3 -m infra.observability.alerts.gateway_deadman
TimeoutStartSec=45
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/harness
NoNewPrivileges=yes
