[Unit]
Description=Textfile collector: container restarts and failed harness units for node-exporter.
After=network-online.target docker.service
Wants=network-online.target
OnFailure=harness-notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/harness/repo
EnvironmentFile=-/opt/harness/harness.env
ExecStart=/usr/bin/python3 -m infra.observability.node_textfile.collect
TimeoutStartSec=60
# No filesystem sandbox: it talks to the docker socket and to systemd.
NoNewPrivileges=yes
