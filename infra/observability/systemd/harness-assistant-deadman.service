[Unit]
Description=Assistant deadman: is the alert path to the assistant served? Three failures write the flag that turns the relay's raw road on, and page once.
After=network-online.target docker.service
Wants=network-online.target
OnFailure=harness-notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/harness/repo
EnvironmentFile=-/opt/harness/harness.env
ExecStart=/usr/bin/python3 -m infra.observability.alerts.assistant_deadman
TimeoutStartSec=60
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/harness
NoNewPrivileges=yes
