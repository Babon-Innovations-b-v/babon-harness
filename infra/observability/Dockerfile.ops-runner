# ops-runner: infra/observability as a cluster image, for the alert relay and
# the deadmen in infra/k8s/monitoring. Standard library only, so this is the
# bare interpreter plus this directory; a third-party import here is a dead
# pager (CLAUDE.md beside this file).
#
# Built by the deploy loop from compose service ops-runner, with the
# repository root as context, and rolled out by digest.
FROM python:3.12.11-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app
COPY infra/observability/ infra/observability/
# The send canary beats the assistant's signal-send heartbeat through these two.
COPY apps/__init__.py apps/__init__.py
COPY apps/assistant/__init__.py apps/assistant/__init__.py
COPY apps/assistant/watch/__init__.py apps/assistant/watch/heartbeat.py apps/assistant/watch/door.py apps/assistant/watch/

USER 65534:65534
