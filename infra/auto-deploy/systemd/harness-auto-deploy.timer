# Fires harness-auto-deploy.service every two minutes. Do not lengthen it: it is
# not a batch size (the webhook starts a cycle on every push). It walks the
# bookmark through a queue one commit per tick, retries every deferral, and is
# the backstop when a push never reaches the webhook.
#
# No Requires= on the service, ON PURPOSE: Requires propagates stop, and a
# `systemctl stop` of the service would take the timer down with it, silently.
# The activation link is Unit= below, which no stop can sever.
[Unit]
Description=Check origin/main for a new commit every two minutes

[Timer]
OnBootSec=3min
OnUnitActiveSec=2min
AccuracySec=15s
Persistent=true
Unit=harness-auto-deploy.service

[Install]
WantedBy=timers.target
