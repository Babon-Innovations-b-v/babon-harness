# The nightly UNSELECTED run of the gate's suite
# (tools/gate_scope/audit_full_run.sh). Its green stamp is what licenses the
# gate to narrow; without one in 48 hours every commit runs the full suite.
[Unit]
Description=Run the whole gate suite once, unnarrowed, to license narrowing
After=network-online.target
Wants=network-online.target
OnFailure=harness-notify-failure@%n.service

[Service]
Type=oneshot
User=harness
Group=harness
WorkingDirectory=/opt/harness/repo
Environment=PATH=/home/harness/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/harness/repo/tools/gate_scope/audit_full_run.sh
TimeoutStartSec=90min
Nice=19
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
