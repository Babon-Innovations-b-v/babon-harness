# The verifying lane (infra/auto-deploy/commit_gate/dispatch.sh): runs the gate
# on every queued commit ahead of the deploy cycle, each in its own exported
# tree. Ships nothing and never takes the cycle's lock.
[Unit]
Description=Verify queued commits ahead of the deploy cycle
After=network-online.target docker.service
Wants=network-online.target
OnFailure=harness-notify-failure@%n.service

[Service]
Type=oneshot
User=harness
Group=harness
WorkingDirectory=/opt/harness/repo
Environment=PATH=/home/harness/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/harness/repo/infra/auto-deploy/commit_gate/dispatch.sh
# COMMIT_GATE_DISPATCH_DEADLINE plus one worst-case pass.
TimeoutStartSec=160min
Nice=15
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
