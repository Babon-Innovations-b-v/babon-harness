# Every five minutes; the push webhook also starts it on every push. No
# Requires= on the service, for the reason harness-auto-deploy.timer gives.
[Unit]
Description=Run the verifying lane every five minutes

[Timer]
OnBootSec=3min
OnUnitActiveSec=5min
AccuracySec=30s
Unit=harness-commit-gate.service

[Install]
WantedBy=timers.target
