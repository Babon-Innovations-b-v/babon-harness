# config/harness.env: the harness's non-secret settings.
#
# Copy to config/harness.env (git ignores it) and fill in. The same lines
# are repeated at the top of the vault secret (see vault.env.example), so
# docker compose on the server sees them too. Nothing in this file is a
# secret; secrets go only in the vault.
#
# Three places hold configuration, nothing else is read:
#   .claude/project.json   GitHub side: repo, board, people
#   config/harness.env     this file
#   the vault              one Scaleway Secret Manager secret, the full env

# --- Server and domain -------------------------------------------------------
# Your domain. The stack serves DOMAIN, cloud., auth., notulen. and deploy.
# subdomains of it; point DNS for all of them at SERVER_IP.
DOMAIN=example.org
# Address Let's Encrypt sends certificate expiry notices to.
ACME_EMAIL=
# The server's public IPv4 address. Filled in by onboarding.
SERVER_IP=
# Scaleway region for the vault, object storage and GPU pool.
SCW_REGION=fr-par
# Where the stack lives on the server: repo checkout, env cache, state.
HARNESS_ROOT=/opt/harness
# Name of the Secret Manager secret that holds the full environment.
VAULT_SECRET_NAME=harness-env
# Optional: public URL of your published bible, for links in messages and
# diagram markers. Empty = relative links into docs/bible.md.
BIBLE_BASE_URL=
# Optional: byline on drawn diagram pages. Empty = "Drawn with Claude".
DIAGRAM_AUTHORS=

# --- Single sign-on ------------------------------------------------------------
# Comma-separated subdomains behind the Nextcloud login.
# infra/nextcloud/oidc-setup.sh registers https://<sub>.DOMAIN/oauth2/callback
# for each one; add a subdomain here and re-run it. Add deploy only if you
# put the deploy host behind the login (its /hooks/* path is HMAC-checked).
SSO_SUBDOMAINS=auth,notulen
# 1 = assert two-factor login for every Nextcloud account each deploy cycle.
# Set only after every account has enrolled a second factor.
NEXTCLOUD_2FA_ENFORCE=0
# Which address the database port is published on. 127.0.0.1 keeps it on the
# server. 0.0.0.0 only for GPU workers off this machine; the password is then
# the only guard on port 5432.
POSTGRES_BIND_ADDRESS=127.0.0.1

# --- Deploy ---------------------------------------------------------------------
# The deploy loop runs in the cluster (infra/k8s/deploy, infra/auto-deploy).
# The deploy-cycle image by reference, :vN or @sha256 (infra/deploy_loop/image).
# Empty = infra/cluster/apply.sh skips the deploy area: no cycle runs.
DEPLOY_CYCLE_IMAGE=
# The repository the cycle clones and every gate Job fetches. Empty =
# https://github.com/<repo>.git with `repo` from .claude/project.json.
DEPLOY_REPO_URL=
# What one gate Job asks for, on the gate pool role. Starting points, not
# measured: raise them when the suite runs out of memory (rc 137, amber).
GATE_JOB_CPU=2
GATE_JOB_MEMORY=6Gi
# A gate run is at most this many gate Jobs at once, one per module group of
# the test register; 1 = one Job for the whole run. Above the number of module
# groups, the gate pools' maximum size is the only cap.
GATE_SHARD_JOBS=64
# Port of the push receiver that Caddy forwards /hooks/* to.
WEBHOOK_PORT=9000
# 0 = pause scheduled deploys (kubectl -n deploy patch cronjob deploy-cycle
# -p '{"spec":{"suspend":true}}' stops the CronJob itself).
AUTO_DEPLOY_ENABLED=1
# 1 = revert a commit the deploy gate rejects and hand it back on a branch, so a
# wrong commit never holds the queue. 0 = a red holds it until a person acts.
EJECT_ENABLED=1
# 1 (with EJECT_ENABLED=0) = open the hand-back pull request without reverting main.
EJECT_DRY_RUN=0
# The address the deploy gate commits a test's quarantine as. The gate believes
# a `quarantined=` line in the test register only when this address added it,
# and the commit hook refuses one any other author adds. Empty = no quarantine
# is believed, so every test stays in the gate.
GATE_AUTHOR_EMAIL=

# --- Assistant ------------------------------------------------------------------
# Name the assistant answers to.
ASSISTANT_NAME=Assistant
# Optional email leg for the assistant's alerts, used when Signal cannot be
# reached. Empty SMTP_HOST = no email. The password goes in the vault.
SMTP_HOST=
SMTP_USER=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# IANA timezone it reads clocks in, e.g. Europe/Amsterdam.
ASSISTANT_TIMEZONE=UTC
# Local time of the morning brief, HH:MM. Empty = the assistant's default.
ASSISTANT_BRIEF_TIME=
# Local time of the daily advisor note, HH:MM. Empty = the assistant's default.
ASSISTANT_ADVISOR_TIME=
# 1 = the assistant may create and change calendar events.
ASSISTANT_AGENDA_WRITE=0
# 1 = the assistant may open and comment on GitHub issues.
ASSISTANT_GITHUB_WRITE=0
# 1 = the assistant sends a reminder before each meeting.
ASSISTANT_MEETING_REMINDERS=0
# Kubernetes namespace the assistant runs in, when it runs on the cluster.
ASSISTANT_NAMESPACE=
# Port of the assistant's tool door. It listens on 8000 inside the docker
# network and is published on 127.0.0.1:OPENCLAW_PORT. Keep 8000: the
# alert-relay reaches the door at assistant:$OPENCLAW_PORT inside the network.
OPENCLAW_PORT=8000
# Path of the assistant's state inside its container. Empty = the assistant's default.
OPENCLAW_STATE_PATH=
# Daily spending cap for the assistant's model calls, in euro. Empty = the assistant's default.
OPENCLAW_DAILY_CAP_EUR=
# Optional: name of a shared team calendar the assistant reads.
TEAM_CALENDAR=
# 1 = voice notes are transcribed (starts the whisper service, compose
# profile voice; needs a transcribe.DOMAIN route in the Caddyfile).
ASSISTANT_VOICE=0
# 1 = the assistant may message a teammate. The scheduled reports leave
# through this tool, so 0 also silences the brief and the advisor.
ASSISTANT_TEAM_MESSAGE=1
# 1 = the assistant may create a video call link on a meeting.
ASSISTANT_VIDEO_CALL=0
# Id of the Talk bot infra/media/connect-talk.sh installs, so the call rooms
# the assistant makes are recorded into minutes. Empty = no recording.
OPENCLAW_TALK_BOT_ID=
# Address of the flexible IP reserved for the media node (infra/media), in the
# media role's first zone. Empty = video calls off: apply.sh skips infra/k8s/media.
MEDIA_PUBLIC_IP=
# Tag of the media-janus and media-recording images built and pushed by hand
# (infra/media/CLAUDE.md). A new build gets a new tag, never a reused one.
MEDIA_IMAGE_TAG=
# Local window a warning page waits through, HH:MM-HH:MM, or off. Critical
# pages leave at any hour. Empty = 22:00-07:30.
ASSISTANT_QUIET_HOURS=
# Base URL other apps page the assistant on (its /webhook/notify door).
OPENCLAW_NOTIFY_URL=http://assistant:8000
# Nextcloud base URL, for Talk posts (claim audit, dead letters).
NC_URL=https://cloud.example.org
# Extra checks for the assistant's monitor, comma-separated. HTTP targets as
# name=https://url; cluster readiness as namespace/deployment (needs a
# kubeconfig). Empty = neither kind is checked.
MONITOR_HTTP_TARGETS=
MONITOR_DEPLOYMENTS=
# CalDAV root of Nextcloud.
AGENDA_BASE_URL=https://cloud.example.org/remote.php/dav
# Calendars the assistant may read, comma-separated: <key>=<backend>|<calendar-id>|<label>,
# e.g. owner=nextcloud|personal|Personal
AGENDA_CALENDARS=

# --- Observability ----------------------------------------------------------------
# Prometheus inside the docker network.
PROM_URL=http://prometheus:9090
# Optional: Loki query endpoint for log reads.
LOKI_URL=
# Subdomains the HTTPS probes check, comma-separated; @ is the bare domain.
PROBE_SUBDOMAINS=@,cloud,notulen

# --- Notulen (meeting minutes) ------------------------------------------------------
# owner/repo the minutes are committed to. Empty = the repo in .claude/project.json.
NOTULEN_TARGET_REPO=
# Directory in that repo the minutes land in.
NOTULEN_TARGET_PATH=business/minutes
# Branch the minutes are committed to.
NOTULEN_TARGET_BRANCH=main
# Comma-separated default attendee names (placeholders until you fill them).
NOTULEN_ATTENDEES=
# Whisper language code of your meetings, e.g. en or nl. Empty = auto-detect.
# Minutes are written in the language of the meeting.
NOTULEN_LANGUAGE=
# Whisper model for CPU transcription. Empty = medium.
NOTULEN_CPU_MODEL=
# Claude model that writes the minutes. Empty = the app's default.
NOTULEN_MODEL=

# --- Object storage (audio uploads) -----------------------------------------------
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
S3_BUCKET=

# --- GPU transcription (optional) -----------------------------------------------------
# 1 = dispatch transcription to the Kubernetes GPU pool; 0 = CPU on the server.
GPU_ENABLED=0
# GPU node pool names, comma-separated, first preferred. Empty = notulen-gpu.
GPU_POOL=
# Node label key the pool name is matched on. Empty = the app's default.
GPU_POOL_LABEL=
# Most GPU jobs a day can start. Empty = 50.
MAX_DAILY_JOBS=
# Kubernetes namespace the GPU jobs run in.
GPU_NAMESPACE=
# Pinned worker image tag (never :latest).
NOTULEN_WORKER_IMAGE=

# --- Cluster ----------------------------------------------------------------------
# The managed Kubernetes cluster every later piece runs on, its node pools and
# their stock fallbacks. infra/cluster/create-cluster.sh creates it, or adopts
# one of this name, from these lines; infra/cluster/CLAUDE.md has the rules.
# Owner of each line, in brackets: [settings] you write it here; [onboarding]
# create-cluster.sh writes it here; [vault] it is a secret and lives only in
# the vault (config/vault.env.example). Region: SCW_REGION above [settings].
#
# Cluster name; a cluster of this name in SCW_REGION is adopted, not recreated. [settings]
CLUSTER_NAME=harness
# Kubernetes version of a new cluster; empty = the newest the provider offers. [settings]
CLUSTER_K8S_VERSION=
# The cluster's id. [onboarding]
CLUSTER_ID=
# The Scaleway project the cluster, the vault and the registry live in. [onboarding]
SCW_PROJECT_ID=
# Zones of SCW_REGION the pools may use, comma-separated; the first is the home
# zone, where every preferred pool sits. [settings]
CLUSTER_ZONES=fr-par-1,fr-par-2,fr-par-3
# Container registry namespace every image is pushed to. [settings]
SCW_REGISTRY=
# Where infra/gate-image/build.sh pushes the gate image. Empty =
# rg.<SCW_REGION>.scw.cloud/<SCW_REGISTRY>/gate. [settings]
GATE_IMAGE_REPOSITORY=
#
# Pool roles. A pod selects a role by the node label POOL_ROLE_LABEL=<role>,
# never a pool name, so it can land on the role's preferred pool or on any of
# its fallbacks. Per role: TYPES (machine types, first preferred), ZONES
# (empty = CLUSTER_ZONES, first = home; one zone = it never leaves it), MIN and
# MAX nodes of the preferred pool (fallbacks are min 0), DISK (root disk, <N>GB;
# the provider cannot resize it later), TAINT (empty or 1 = tainted
# POOL_ROLE_LABEL=<role>:NoSchedule, so only pods that tolerate it land there;
# 0 = untainted; key=value = that taint instead),
# SHARED_SECURITY_GROUP (1 = fallbacks join the preferred pool's security
# group). All [settings]. A role not in POOL_ROLES gets no pools.
POOL_ROLES=system,gate,media,gpu
POOL_ROLE_LABEL=harness/role
# system: the untainted pool, where everything without a role lands.
POOL_SYSTEM_TYPES=PRO2-XS,GP1-XS,POP2-4C-16G
POOL_SYSTEM_MIN=1
POOL_SYSTEM_MAX=3
POOL_SYSTEM_DISK=100GB
POOL_SYSTEM_TAINT=0
# gate: the deploy gate's test runs.
POOL_GATE_TYPES=PRO2-S,GP1-S,POP2-8C-32G
POOL_GATE_MIN=0
POOL_GATE_MAX=4
POOL_GATE_DISK=100GB
# media: video calls; its public address is zonal, so it keeps to one zone.
POOL_MEDIA_TYPES=PRO2-XS,GP1-XS,POP2-4C-16G
POOL_MEDIA_ZONES=fr-par-1
POOL_MEDIA_MIN=0
POOL_MEDIA_MAX=1
POOL_MEDIA_DISK=40GB
POOL_MEDIA_SHARED_SECURITY_GROUP=1
# gpu: transcription Jobs. Scales to zero; bills only while a Job runs. The
# taint is the one the notulen Jobs tolerate (infra/gpu-jobs), and GPU_POOL
# (GPU section above) lists this role's pool names (python3 -m infra.cluster.pool_fallbacks --pools).
POOL_GPU_TYPES=L4-1-24G
POOL_GPU_MIN=0
POOL_GPU_MAX=1
POOL_GPU_DISK=125GB
POOL_GPU_TAINT=workload=notulen
# Warm gate nodes: how many gate nodes stay up on WORKING_DAYS during
# WORKING_HOURS (local time in ASSISTANT_TIMEZONE), so a push in working hours
# does not wait for a node to boot. Read by the deploy loop's warm-node
# schedule, which a later piece adds; nothing reads them yet. [settings]
POOL_GATE_WARM=2
WORKING_DAYS=Mon-Fri
WORKING_HOURS=08:00-18:00
#
# The cluster's front door: one cloud load balancer in front of Caddy
# (infra/k8s/ingress). infra/cluster/apply.sh skips the ingress area while
# INGRESS_LB_IP_ID is empty, so no load balancer is made on a throwaway
# address. Reserve a flexible IP in INGRESS_LB_ZONE first and point DNS for
# DOMAIN and its subdomains at it. [settings]
INGRESS_LB_IP_ID=
# Zone of the load balancer; empty = the first of CLUSTER_ZONES. [settings]
INGRESS_LB_ZONE=
# The provider's load balancer size; empty = LB-S. [settings]
INGRESS_LB_TYPE=
#
# Volume backups (infra/k8s/backups): every claim labelled harness/backup=true
# is snapshotted nightly with this VolumeSnapshotClass, and the newest
# BACKUP_KEEP per claim are kept. Empty = scw-snapshot and 7. [settings]
BACKUP_SNAPSHOT_CLASS=
BACKUP_KEEP=

# --- Email (optional) -----------------------------------------------------------------
# Scaleway Transactional Email project, region and verified sender. The send
# credential is the scw CLI key, never a file.
TEM_PROJECT_ID=
TEM_REGION=fr-par
TEM_FROM=
