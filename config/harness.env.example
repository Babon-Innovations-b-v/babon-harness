# config/harness.env: the harness's non-secret settings.
#
# Copy to config/harness.env (git ignores it) and fill in. The same lines
# are repeated at the top of the vault secret (see vault.env.example), so
# docker compose on the server sees them too. Nothing in this file is a
# secret; secrets go only in the vault.
#
# Three places hold configuration, nothing else is read:
#   .claude/project.json   GitHub side: repo, board, people
#   config/harness.env     this file
#   the vault              one Scaleway Secret Manager secret, the full env

# --- Server and domain -------------------------------------------------------
# Your domain. The stack serves DOMAIN, cloud., auth., notulen. and deploy.
# subdomains of it; point DNS for all of them at SERVER_IP.
DOMAIN=example.org
# Address Let's Encrypt sends certificate expiry notices to.
ACME_EMAIL=
# The server's public IPv4 address. Filled in by onboarding.
SERVER_IP=
# Scaleway region for the vault, object storage and GPU pool.
SCW_REGION=fr-par
# Where the stack lives on the server: repo checkout, env cache, state.
HARNESS_ROOT=/opt/harness
# Name of the Secret Manager secret that holds the full environment.
VAULT_SECRET_NAME=harness-env
# Optional: public URL of your published bible, for links in messages and
# diagram markers. Empty = relative links into docs/bible.md.
BIBLE_BASE_URL=
# Optional: byline on drawn diagram pages. Empty = "Drawn with Claude".
DIAGRAM_AUTHORS=

# --- Single sign-on ------------------------------------------------------------
# Comma-separated subdomains behind the Nextcloud login.
# infra/nextcloud/oidc-setup.sh registers https://<sub>.DOMAIN/oauth2/callback
# for each one; add a subdomain here and re-run it. Add deploy only if you
# put the deploy host behind the login (its /hooks/* path is HMAC-checked).
SSO_SUBDOMAINS=auth,notulen
# 1 = assert two-factor login for every Nextcloud account each deploy cycle.
# Set only after every account has enrolled a second factor.
NEXTCLOUD_2FA_ENFORCE=0
# Which address the database port is published on. 127.0.0.1 keeps it on the
# server. 0.0.0.0 only for GPU workers off this machine; the password is then
# the only guard on port 5432.
POSTGRES_BIND_ADDRESS=127.0.0.1

# --- Deploy ---------------------------------------------------------------------
# Host port of the deploy webhook service that Caddy forwards /hooks/* to.
WEBHOOK_PORT=9000
# 0 = pause scheduled deploys. `systemctl disable` is undone within two minutes.
AUTO_DEPLOY_ENABLED=1
# 1 = revert a commit the deploy gate rejects and hand it back on a branch.
EJECT_ENABLED=0
# 1 (with EJECT_ENABLED=0) = open the hand-back pull request without reverting main.
EJECT_DRY_RUN=0

# --- Assistant ------------------------------------------------------------------
# Name the assistant answers to.
ASSISTANT_NAME=Assistant
# Optional email leg for the assistant's alerts, used when Signal cannot be
# reached. Empty SMTP_HOST = no email. The password goes in the vault.
SMTP_HOST=
SMTP_USER=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# IANA timezone it reads clocks in, e.g. Europe/Amsterdam.
ASSISTANT_TIMEZONE=UTC
# Local time of the morning brief, HH:MM. Empty = the assistant's default.
ASSISTANT_BRIEF_TIME=
# Local time of the daily advisor note, HH:MM. Empty = the assistant's default.
ASSISTANT_ADVISOR_TIME=
# 1 = the assistant may create and change calendar events.
ASSISTANT_AGENDA_WRITE=0
# 1 = the assistant may open and comment on GitHub issues.
ASSISTANT_GITHUB_WRITE=0
# 1 = the assistant sends a reminder before each meeting.
ASSISTANT_MEETING_REMINDERS=0
# Kubernetes namespace the assistant runs in, when it runs on the cluster.
ASSISTANT_NAMESPACE=
# Port of the assistant's tool door. It listens on 8000 inside the docker
# network and is published on 127.0.0.1:OPENCLAW_PORT. Keep 8000: the
# alert-relay reaches the door at assistant:$OPENCLAW_PORT inside the network.
OPENCLAW_PORT=8000
# Path of the assistant's state inside its container. Empty = the assistant's default.
OPENCLAW_STATE_PATH=
# Daily spending cap for the assistant's model calls, in euro. Empty = the assistant's default.
OPENCLAW_DAILY_CAP_EUR=
# Optional: name of a shared team calendar the assistant reads.
TEAM_CALENDAR=
# 1 = voice notes are transcribed (starts the whisper service, compose
# profile voice; needs a transcribe.DOMAIN route in the Caddyfile).
ASSISTANT_VOICE=0
# 1 = the assistant may message a teammate. The scheduled reports leave
# through this tool, so 0 also silences the brief and the advisor.
ASSISTANT_TEAM_MESSAGE=1
# 1 = the assistant may create a video call link on a meeting.
ASSISTANT_VIDEO_CALL=0
# Local window a warning page waits through, HH:MM-HH:MM, or off. Critical
# pages leave at any hour. Empty = 22:00-07:30.
ASSISTANT_QUIET_HOURS=
# Base URL other apps page the assistant on (its /webhook/notify door).
OPENCLAW_NOTIFY_URL=http://assistant:8000
# Nextcloud base URL, for Talk posts (claim audit, dead letters).
NC_URL=https://cloud.example.org
# Extra checks for the assistant's monitor, comma-separated. HTTP targets as
# name=https://url; cluster readiness as namespace/deployment (needs a
# kubeconfig). Empty = neither kind is checked.
MONITOR_HTTP_TARGETS=
MONITOR_DEPLOYMENTS=
# CalDAV root of Nextcloud.
AGENDA_BASE_URL=https://cloud.example.org/remote.php/dav
# Calendars the assistant may read, comma-separated: <key>=<backend>|<calendar-id>|<label>,
# e.g. owner=nextcloud|personal|Personal
AGENDA_CALENDARS=

# --- Observability ----------------------------------------------------------------
# Prometheus inside the docker network.
PROM_URL=http://prometheus:9090
# Optional: Loki query endpoint for log reads.
LOKI_URL=
# Subdomains the HTTPS probes check, comma-separated; @ is the bare domain.
PROBE_SUBDOMAINS=@,cloud,notulen

# --- Notulen (meeting minutes) ------------------------------------------------------
# owner/repo the minutes are committed to. Empty = the repo in .claude/project.json.
NOTULEN_TARGET_REPO=
# Directory in that repo the minutes land in.
NOTULEN_TARGET_PATH=business/minutes
# Branch the minutes are committed to.
NOTULEN_TARGET_BRANCH=main
# Comma-separated default attendee names (placeholders until you fill them).
NOTULEN_ATTENDEES=
# Whisper language code of your meetings, e.g. en or nl. Empty = auto-detect.
# Minutes are written in the language of the meeting.
NOTULEN_LANGUAGE=
# Whisper model for CPU transcription. Empty = medium.
NOTULEN_CPU_MODEL=
# Claude model that writes the minutes. Empty = the app's default.
NOTULEN_MODEL=

# --- Object storage (audio uploads) -----------------------------------------------
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
S3_BUCKET=

# --- GPU transcription (optional) -----------------------------------------------------
# 1 = dispatch transcription to the Kubernetes GPU pool; 0 = CPU on the server.
GPU_ENABLED=0
# GPU node pool names, comma-separated, first preferred. Empty = notulen-gpu.
GPU_POOL=
# Node label key the pool name is matched on. Empty = the app's default.
GPU_POOL_LABEL=
# Most GPU jobs a day can start. Empty = 50.
MAX_DAILY_JOBS=
# Kubernetes namespace the GPU jobs run in.
GPU_NAMESPACE=
# Pinned worker image tag (never :latest).
NOTULEN_WORKER_IMAGE=
# Container registry namespace the worker image is pushed to.
SCW_REGISTRY=

# --- Email (optional) -----------------------------------------------------------------
# Scaleway Transactional Email project, region and verified sender. The send
# credential is the scw CLI key, never a file.
TEM_PROJECT_ID=
TEM_REGION=fr-par
TEM_FROM=
