# config/vault.env.example: every secret the harness reads, one line each.
#
# The vault is one Scaleway Secret Manager secret (VAULT_SECRET_NAME,
# default harness-env) holding the FULL environment: every line of
# config/harness.env first, then these. Assemble it in a private file
# (never committed; git ignores config/vault.env), push it with
#   infra/secrets/push-env.sh <file>
# and the server pulls it to $HARNESS_ROOT/harness.env (mode 600) each
# deploy cycle. Delete the local copy when you are done.
#
# Scaleway API keys are NOT here: the vault and email use the key from your
# scw CLI config, and the server's read-only vault key lives in
# $HARNESS_ROOT/scw-secrets.env. GPU workers get credentials only through a
# Kubernetes Secret that onboarding creates, never inline.

# ===== paste config/harness.env here =====

# --- Model ----------------------------------------------------------------------
# Anthropic API key for the assistant and the minutes writer (billed separately from claude.ai).
ANTHROPIC_API_KEY=

# --- Assistant: Signal ----------------------------------------------------------
# The Signal number the assistant sends from, E.164 (+countrycode...).
SIGNAL_BOT_NUMBER=
# Default recipient of briefs and alerts, E.164.
SIGNAL_RECIPIENT=
# Who may talk to the assistant, comma-separated: E.164 numbers or uuid:<id>.
SIGNAL_ALLOWLIST=
# People the assistant knows, comma-separated: <key>=Name:role[:+E164[:language]],
# where <key> is the sender's allowlist entry. Language defaults to en.
SIGNAL_PEOPLE=
# Shared secret the Signal bridge signs webhook calls to the assistant with.
OPENCLAW_WEBHOOK_SECRET=
# Auth token for the OpenClaw gateway port (openssl rand -hex 32).
OPENCLAW_GATEWAY_TOKEN=
# Only during a rotation of OPENCLAW_WEBHOOK_SECRET: the old value, still
# accepted until apps/assistant/ops rotation finishes. Empty otherwise.
OPENCLAW_WEBHOOK_SECRET_PREV=
# Optional: read-only DSN the assistant's db_query tool reads the stack
# database with. Empty = that tool is not offered.
OPENCLAW_DB_RO_URL=
# Optional: a Nextcloud account and Talk room token the assistant posts
# the claim audit and dead letters to.
NC_ALERTS_USER=
NC_ALERTS_PASSWORD=
NC_ALERTS_ROOM=
# Optional: password for SMTP_USER, when the alert email leg is used.
SMTP_PASSWORD=

# --- Assistant: calendar ------------------------------------------------------------
# Nextcloud account the assistant reads calendars as.
AGENDA_USER=
# Nextcloud app password for that account (Settings > Security > Devices).
AGENDA_APP_PASSWORD=

# --- Video calls and recording (optional, infra/media) ---------------------------
# Shared secret Nextcloud Talk signs the recording bot's webhooks with.
TALK_BOT_SECRET=
# Talk and the signaling server (HPB) share this.
TALK_SIGNALING_SECRET=
# Talk and the recording server share this.
TALK_RECORDING_SECRET=
# The recording server's login to the signaling server.
TALK_INTERNAL_SECRET=
# Session keys of the signaling server: 32 and 16 random characters.
TALK_SESSION_HASHKEY=
TALK_SESSION_BLOCKKEY=

# --- GitHub tokens (fine-grained, one repository each) -----------------------------
# Assistant: Issues and Contents read; plus Issues write when ASSISTANT_GITHUB_WRITE=1.
GITHUB_ASSISTANT_TOKEN=
# Notulen: Contents write on NOTULEN_TARGET_REPO only.
GITHUB_NOTULEN_PAT=
# Deploy loop: Commit statuses and Deployments write; plus Contents and Pull requests write when EJECT_ENABLED=1.
DEPLOY_STATUS_TOKEN=
# HMAC secret of the GitHub push webhook (openssl rand -hex 32); the same value goes in the repo's webhook settings.
DEPLOY_WEBHOOK_SECRET=

# --- Database ----------------------------------------------------------------------
# Owner of the stack database.
POSTGRES_USER=harness
# Its password (openssl rand -hex 24).
POSTGRES_PASSWORD=
# The stack database: dashboards, notulen, assistant tables.
POSTGRES_DB=harness
# Optional: external DSN to the same database, for GPU workers off this server.
DB_URL_OPS=

# --- Nextcloud ----------------------------------------------------------------------
# Nextcloud's own database name.
NEXTCLOUD_DB_NAME=nextcloud
# Nextcloud's own database user.
NEXTCLOUD_DB_USER=nextcloud
# Its password (openssl rand -hex 24).
NEXTCLOUD_DB_PASSWORD=
# First Nextcloud admin account, created on first boot.
NEXTCLOUD_ADMIN_USER=admin
# Its password; change it after first login and enrol a second factor.
NEXTCLOUD_ADMIN_PASSWORD=

# --- Single sign-on -------------------------------------------------------------------
# OIDC client id, written by infra/nextcloud/oidc-setup.sh.
OIDC_CLIENT_ID=
# OIDC client secret, written by infra/nextcloud/oidc-setup.sh.
OIDC_CLIENT_SECRET=
# oauth2-proxy cookie encryption key: python3 -c 'import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
OAUTH2_PROXY_COOKIE_SECRET=

# --- Object storage --------------------------------------------------------------------
# Access key of the bucket in S3_BUCKET.
S3_ACCESS_KEY=
# Secret key of the bucket in S3_BUCKET.
S3_SECRET_KEY=

# --- GPU (only when GPU_ENABLED=1) -------------------------------------------------------
# Base64 kubeconfig the dashboard submits GPU jobs with.
KUBECONFIG_B64=
# Optional: Hugging Face token that has accepted the pyannote model terms.
# Without it the GPU worker writes minutes without speaker labels.
HF_TOKEN=
# Registry pull key for infra/gpu/apply.sh, required when GPU_ENABLED=1: an
# API key limited to registry read. apply.sh refuses to run without it.
SCW_REGISTRY_PULL_KEY=
