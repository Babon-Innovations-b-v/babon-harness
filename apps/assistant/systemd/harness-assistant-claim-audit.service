[Unit]
Description=Assistant claim audit: re-run the draft guards over the messages that went out in the last seven days and post the report
After=network-online.target docker.service
Wants=network-online.target
OnFailure=harness-notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/harness/repo
EnvironmentFile=-/opt/harness/harness.env
ExecStart=/usr/bin/python3 -m apps.assistant.watch claim-audit
TimeoutStartSec=600
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/harness -/var/lib/node-exporter-textfile
NoNewPrivileges=yes
