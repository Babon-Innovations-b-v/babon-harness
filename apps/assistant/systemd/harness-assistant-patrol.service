[Unit]
Description=Assistant patrol: POST /webhook/patrol so the assistant works its open worklist and takes one look around for trouble no alert covers
After=network-online.target docker.service
Wants=network-online.target
OnFailure=harness-notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/harness/repo
EnvironmentFile=-/opt/harness/harness.env
ExecStart=/usr/bin/python3 -m apps.assistant.watch trigger /webhook/patrol
TimeoutStartSec=420
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/harness
NoNewPrivileges=yes
