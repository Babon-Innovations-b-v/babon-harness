[Unit]
Description=Assistant meeting reminders: POST /webhook/meeting-reminders so a call about to start is announced to the people in it
After=network-online.target docker.service
Wants=network-online.target
OnFailure=harness-notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/harness/repo
EnvironmentFile=-/opt/harness/harness.env
ExecStart=/usr/bin/python3 -m apps.assistant.watch trigger /webhook/meeting-reminders
TimeoutStartSec=180
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/harness
NoNewPrivileges=yes
